# =============================================================================
# Maitri — Hotel Operating System
# =============================================================================
# Copy this file to .env.local and fill in your actual values.
# See docs/SETUP_TODO.md for instructions on getting each credential.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED · Core
# -----------------------------------------------------------------------------

# Supabase — https://supabase.com (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
NEXT_PUBLIC_APP_URL=https://your-domain.com

# Anthropic Claude — https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# App URL (production: your custom domain)



# -----------------------------------------------------------------------------
# CHANNELS · Guest Communication
# -----------------------------------------------------------------------------

# LINE Messaging API — https://developers.line.biz
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# WhatsApp Business API — https://business.facebook.com
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=any_random_string_you_choose

# WeChat (optional, for Chinese guests)
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# SendGrid (transactional email)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=hello@yourdomain.com


# -----------------------------------------------------------------------------
# PAYMENTS
# -----------------------------------------------------------------------------

# Omise (Thai payment gateway, PromptPay) — https://omise.co
OMISE_PUBLIC_KEY=pkey_test_...
OMISE_SECRET_KEY=skey_test_...

# Stripe (international, optional)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BILLING_PROVIDER=stripe

# Stripe subscription price ids (Dashboard → Products → Pricing)
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_STANDARD=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_ENTERPRISE=price_...


# -----------------------------------------------------------------------------
# CHANNEL MANAGER (OTA)
# -----------------------------------------------------------------------------

# Aggregator: HotelRunner — https://hotelrunner.com
HOTELRUNNER_API_KEY=
HOTELRUNNER_API_SECRET=

# Direct: Booking.com (after Connectivity Partner approval)
BOOKING_COM_USERNAME=
BOOKING_COM_PASSWORD=

# Direct: Agoda YCS
AGODA_API_KEY=

# Direct: Airbnb
AIRBNB_CLIENT_ID=
AIRBNB_CLIENT_SECRET=


# -----------------------------------------------------------------------------
# THAI COMPLIANCE
# -----------------------------------------------------------------------------

# e-Tax Provider (INET / Frank / Leceipt)
ETAX_PROVIDER=inet
ETAX_USERNAME=
ETAX_PASSWORD=
ETAX_CERTIFICATE_PATH=/path/to/cert.p12


# -----------------------------------------------------------------------------
# ACCOUNTING
# -----------------------------------------------------------------------------

# FlowAccount — https://flowaccount.com
FLOWACCOUNT_API_KEY=

# PEAK — https://peakaccount.com
PEAK_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# VERCEL / DEPLOYMENT
# ─────────────────────────────────────────────────────────────────────────────

# Secret for Vercel Cron Jobs (random string)
CRON_SECRET=your_random_cron_secret_here

# ─────────────────────────────────────────────────────────────────────────────
# FEATURE FLAGS (optional overrides)
# ─────────────────────────────────────────────────────────────────────────────

# Set DEMO_MODE=true to bypass real API calls (useful for UI testing)
DEMO_MODE=false


# PWA / Storage / Monitoring placeholders
SUPABASE_STORAGE_BUCKET=maitri-assets
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Optional distributed rate limit provider
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional F&B printer bridge
KITCHEN_PRINT_WEBHOOK_URL=
